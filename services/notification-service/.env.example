NODE_ENV=development
PORT=3002
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
INTERNAL_SERVICE_TOKEN=change-this-internal-service-token-at-least-32-characters
SHUTDOWN_TIMEOUT_MS=75000
AUTH_SERVICE_TIMEOUT_MS=3000
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BACKOFF_MS=1000
WORKER_CONCURRENCY=3
DELIVERY_TIMEOUT_MS=10000
OUTBOX_POLL_MS=1000
SOCKET_ORIGINS=http://localhost:3000,http://localhost:5173
SOCKET_CHECK_MS=15000
PRESENCE_TTL_MS=60000
REALTIME_PREFIX=notification-service:realtime
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
REMINDERS_ENABLED=true
REMINDER_FIRST_MS=1800000
REMINDER_SECOND_MS=86400000
REMINDER_MAX_COUNT=2
REMINDER_TYPES=SYSTEM,SECURITY
SCHEDULE_RECHECK_MS=60000
DATABASE_URL=postgresql://notifications:change-notification-db-password@localhost:5632/micro_notifications
REDIS_HOST=localhost
REDIS_PORT=16382
AUTH_SERVICE_URL=http://localhost:3001
# Direct Node development may introspect Auth itself; Compose requires gateway identity.
REQUIRE_GATEWAY_IDENTITY=false
GATEWAY_IDENTITY_SECRET=change-this-gateway-identity-secret-at-least-32-characters
