# Local microservice Compose stack. Do not reuse these example secrets remotely.
NODE_ENV=development
PORT=8000
GATEWAY_RATE_LIMIT_MAX=100
GATEWAY_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_ROUTE_RATE_LIMIT_MAX=100
GATEWAY_ROUTE_RATE_LIMIT_WINDOW_MS=60000
GATEWAY_LOGIN_RATE_LIMIT_MAX=10
GATEWAY_REGISTER_RATE_LIMIT_MAX=5
GATEWAY_AUTH_RATE_LIMIT_WINDOW_MS=900000
GATEWAY_SESSION_RATE_LIMIT_MAX=30
GATEWAY_SOCKET_COOKIE_NAME=notificationSocketAccess
GATEWAY_IDENTITY_SECRET=change-this-gateway-identity-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=change-auth-db-password
AUTH_DB_NAME=micro_auth
NOTIFICATION_DB_USER=notifications
NOTIFICATION_DB_PASSWORD=change-notification-db-password
NOTIFICATION_DB_NAME=micro_notifications
INTERNAL_SERVICE_TOKEN=change-this-internal-service-token-at-least-32-characters
ACCESS_TOKEN_SECRET=change-this-access-token-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=change-this-refresh-token-secret-at-least-32-characters
REFRESH_COOKIE_SECURE=false
SHUTDOWN_TIMEOUT_MS=75000
AUTH_SERVICE_TIMEOUT_MS=3000
REDIS_MAXMEMORY=256mb
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BACKOFF_MS=1000
WORKER_CONCURRENCY=3
DELIVERY_TIMEOUT_MS=10000
OUTBOX_POLL_MS=1000
SOCKET_ORIGINS=http://localhost:3000,http://localhost:5173
SOCKET_CHECK_MS=15000
PRESENCE_TTL_MS=60000
REALTIME_PREFIX=notification-service:realtime
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
REMINDERS_ENABLED=true
REMINDER_FIRST_MS=1800000
REMINDER_SECOND_MS=86400000
REMINDER_MAX_COUNT=2
REMINDER_TYPES=SYSTEM,SECURITY
SCHEDULE_RECHECK_MS=60000
