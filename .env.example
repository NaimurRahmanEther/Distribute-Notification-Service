# Local Docker Compose settings. Copy to .env before starting.
NODE_ENV=development
PORT=8000

POSTGRES_USER=postgres
POSTGRES_PASSWORD=12345
POSTGRES_DB=notification_service
# Use Compose service names inside containers, not localhost.
# Keep these credentials consistent with POSTGRES_USER/PASSWORD/DB.
# URL-encode special characters in the database URL credentials.
DATABASE_URL=postgresql://postgres:12345@postgres:5432/notification_service
REDIS_HOST=redis
REDIS_PORT=6379

ACCESS_TOKEN_SECRET=local-test-access-secret-change-in-production
REFRESH_TOKEN_SECRET=local-test-refresh-secret-change-in-production
REFRESH_COOKIE_SECURE=false

# Notification queue and worker
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BACKOFF_MS=1000
WORKER_CONCURRENCY=3
DELIVERY_TIMEOUT_MS=10000
OUTBOX_POLL_MS=1000

SOCKET_ORIGINS=http://localhost:3000,http://localhost:5173
SOCKET_CHECK_MS=15000
PRESENCE_TTL_MS=60000
REALTIME_PREFIX=notification-service:realtime

RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
