NODE_ENV=development
PORT=8000

DATABASE_URL=postgresql://postgres:12345@localhost:5432/notification_service

REDIS_HOST=localhost
REDIS_PORT=6379
# Phase 3: separate outbox dispatcher and notification worker
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BACKOFF_MS=1000
WORKER_CONCURRENCY=3
DELIVERY_TIMEOUT_MS=10000
OUTBOX_POLL_MS=1000

SOCKET_ORIGINS=http://localhost:3000,http://localhost:5173
SOCKET_CHECK_MS=15000
PRESENCE_TTL_MS=60000
REALTIME_PREFIX=notification-service:realtime

RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
