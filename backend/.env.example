# Direct Node development; copy to .env and set local values.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ACCESS_TOKEN_SECRET=change-this-access-token-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=change-this-refresh-token-secret-at-least-32-characters
REFRESH_COOKIE_SECURE=false
SHUTDOWN_TIMEOUT_MS=75000
REDIS_MAXMEMORY=256mb
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BACKOFF_MS=1000
WORKER_CONCURRENCY=3
DELIVERY_TIMEOUT_MS=10000
OUTBOX_POLL_MS=1000
SOCKET_ORIGINS=http://localhost:3000,http://localhost:5173
SOCKET_CHECK_MS=15000
PRESENCE_TTL_MS=60000
REALTIME_PREFIX=notification-service:realtime
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
REMINDERS_ENABLED=true
REMINDER_FIRST_MS=1800000
REMINDER_SECOND_MS=86400000
REMINDER_MAX_COUNT=2
REMINDER_TYPES=SYSTEM,SECURITY
SCHEDULE_RECHECK_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
DATABASE_URL=postgresql://notification:change-this-local-db-password@localhost:5632/notification
REDIS_HOST=localhost
REDIS_PORT=16382
