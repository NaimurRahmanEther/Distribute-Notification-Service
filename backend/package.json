{
  "name": "notification-backend",
  "version": "1.0.0",
  "description": "Modular notification backend with authentication, BullMQ workers and provider strategies",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/notification-worker.js",
    "outbox": "node src/workers/outbox.js",
    "migrate:up": "node src/database/migrate.js",
    "migrate:down": "node src/database/migrate.js down",
    "push:keys": "web-push generate-vapid-keys --json"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bullmq": "^6.3.13",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.6",
    "bcrypt": "^6.0.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "rate-limit-redis": "^6.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4"
  },
  "private": true
}
